# Backend UNIDATA - variables que tienen que estar seteadas en Railway / AWS

# === Modo de conexion a los RDS productivos ===
# true  (default): SSH tunnel a bastion EC2 -> RDS. Usar en dev local y Railway.
# false: conexion VPC privada directa. Usar en Fargate dentro de la misma VPC
#        que los RDS (vpc-0f1f604c0d3e3ea06). Cuando es false, las variables
#        BASTION_* y LOCAL_PORT_* no se leen.
USE_SSH_TUNNEL=true

# === Unistore (RDS via SSH bastion) ===
BASTION_HOST_UNISTORE=3.139.209.227
BASTION_PORT_UNISTORE=22
BASTION_USER_UNISTORE=ec2-user
# En Railway: NO setear esta. Setear BASTION_KEY_UNISTORE_BASE64 (contenido del .pem en base64)
# y entrypoint.sh la materializa a /app/keys/unistore-bastion.pem.
# Para dev local: BASTION_KEY_PATH_UNISTORE=C:\path\al\.pem
BASTION_KEY_PATH_UNISTORE=
BASTION_KEY_UNISTORE_BASE64=

PROD_DB_HOST_UNISTORE=unistore-prod-db.c1u2aymu0gg8.us-east-2.rds.amazonaws.com
PROD_DB_PORT_UNISTORE=5432
PROD_DB_NAME_UNISTORE=unistore_api
PROD_DB_USER_UNISTORE=
PROD_DB_PASSWORD_UNISTORE=

LOCAL_PORT_UNISTORE=5433

# === Unidrop ===
BASTION_HOST_UNIDROP=18.191.119.38
BASTION_PORT_UNIDROP=22
BASTION_USER_UNIDROP=ec2-user
BASTION_KEY_PATH_UNIDROP=
BASTION_KEY_UNIDROP_BASE64=

PROD_DB_HOST_UNIDROP=unidrop-prod-db.c1u2aymu0gg8.us-east-2.rds.amazonaws.com
PROD_DB_PORT_UNIDROP=5432
PROD_DB_NAME_UNIDROP=unidrop_api
PROD_DB_USER_UNIDROP=
PROD_DB_PASSWORD_UNIDROP=

LOCAL_PORT_UNIDROP=5434

# === Seed admin (solo se aplica si users.db esta vacia al boot) ===
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# === JWT ===
JWT_SECRET=                       # 64+ chars random; usar `openssl rand -hex 64`
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=12

# === CORS - frontend allowed origins, separados por coma ===
ALLOWED_ORIGINS=http://localhost:3000,https://unidata.vercel.app

# === Logística — Carga DigiPWMS ===
# DigiP / Patagonia WMS
DIGIP_API_KEY=1afacc94-4c12-414e-8f8d-f6812df956f3

# Contabilium (expansión de combos en flujo MELI_API)
CB_CLIENT_ID=
CB_CLIENT_SECRET=

# MercadoLibre Fox (flujos MELI_DB y MELI_API)
ML_APP_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=
ML_ACCESS_TOKEN=          # se auto-refresca en cada run
ML_USER_ID=1088266694

# TiendaNube Unistore (flujo TN_UNI)
TN_UNI_STORE_ID=1771149
TN_UNI_ACCESS_TOKEN=

# === Jira Flow (IT/Data — SITU + ITDEV + Confluence + Gemini) ===
JIRA_BASE_URL=https://unistore-it.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ITDEV_PROJECT_KEY=ITDEV
SITU_PROJECT_KEY=SITU
ITDEV_BOARD_ID=102
SUBTASK_ISSUE_TYPE=Subtarea
CONFLUENCE_DEFAULT_SPACE=ID
DEFAULT_TRIAGER_ACCOUNT_ID=
DEFAULT_LABEL=
TEAMS_WEBHOOK_URL=

# === Unidrop API (para cancelar integracion MELI desde Finanzas) ===
# JWT admin generado desde el panel de Unidrop. Sin esto, el boton
# "Cancelar integracion" falla con 500.
UNIDROP_API_URL=https://api.unidrop.com.ar
UNIDROP_API_TOKEN=

# === Cresium (motor de payouts masivos de devoluciones ML + suscripciones) ===
# DESHABILITADO por default. Con FEATURE_CRESIUM_REFUNDS_ENABLED=false se puede
# armar lotes y previsualizar, pero NINGUN call sale a Cresium (no se mueve
# plata). Para activar transferencias reales: cargar los 5 secrets de abajo y
# poner el flag en true. Mismos valores que Unidrop-Back (Cresium company 219).
FEATURE_CRESIUM_REFUNDS_ENABLED=false
FEATURE_CRESIUM_POLLING_ENABLED=false
CRESIUM_API_BASE_URL=https://api.cresium.app
CRESIUM_API_KEY=
CRESIUM_API_SECRET=
CRESIUM_COMPANY_ID=219
CRESIUM_WEBHOOK_SECRET=
# Origen publico del backend SIN path (se le concatena /api/cresium/webhook).
# Tiene que matchear EXACTO lo registrado en el panel de Cresium — forma parte
# de la firma del webhook entrante.
CRESIUM_WEBHOOK_PUBLIC_URL=https://api.unidatacenter.com.ar
