# Plantilla de variables de entorno.
# Copiar este archivo a .env.local y reemplazar los valores con los reales.
# El archivo .env.local NO se commitea (esta en .gitignore).

# --- Supabase REST API ---

# URL del proyecto Supabase (publica, visible en el panel)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Publishable key (antes anon key) - publica, va al navegador.
# Respeta las reglas de seguridad (RLS) que definamos en la base.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key (antes service_role key) - PRIVADA, solo en el servidor.
# Ignora reglas de seguridad: tiene acceso total a la base.
# NUNCA debe llegar al navegador ni a un repo publico.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Postgres directo (para Drizzle) ---

# Connection string para queries de runtime (transaction pooler, puerto 6543).
# Optimizada para Next.js/serverless. Usar la opcion "Transaction" del panel Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Connection string para migraciones (direct o session pooler).
# Permite operaciones largas y prepared statements. Usar la opcion "Session" o "Direct" del panel.
DIRECT_URL=postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
